# ─────────────────────────────────────────────────────────────────────────────
#  UPtool backend (plugin bridge) configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` (the server reads real env vars; this file documents them).

# Port the plugin-bridge server listens on (frontend dev proxy targets this).
PORT=8787

# Absolute path to your filehost plugin directory (the folder containing the
# *.plugin.mjs files). If unset, the bundled sample/mock plugin is used.
# Example (Windows): PLUGINS_DIR=C:\Users\Informatics\Documents\...\plugins\filehosts
# Example (repo):    PLUGINS_DIR=./reference/hostkit/plugins/filehosts
# PLUGINS_DIR=./reference/hostkit/plugins/filehosts

# Optional hard cap on upload size in bytes (0 / unset = unlimited).
# MAX_UPLOAD_BYTES=0

# ── Per-host credentials ─────────────────────────────────────────────────────
# Keys follow the convention <HOSTID>_<FIELD>, uppercased. The host id is the
# plugin's exported `id` (e.g. "rapidgator"). These are merged with (and
# overridden by) any credentials sent from the UI.
#
# Rapidgator (token OR username+password [+2FA]):
# RAPIDGATOR_TOKEN=
# RAPIDGATOR_USERNAME=
# RAPIDGATOR_PASSWORD=
# RAPIDGATOR_TWOFACTORCODE=
# RAPIDGATOR_FOLDERID=
#
# Keep2Share / FileBoom / FileJoker — add fields once their adapters are known:
# KEEP2SHARE_USERNAME=
# KEEP2SHARE_PASSWORD=
# FILEBOOM_USERNAME=
# FILEBOOM_PASSWORD=
# FILEJOKER_USERNAME=
# FILEJOKER_PASSWORD=
